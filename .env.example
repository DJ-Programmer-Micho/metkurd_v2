APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

MOBILE_API_TOKEN_EXPIRATION_DAYS=90
MOBILE_API_DOWNLOAD_URL_TTL_MINUTES=30

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# In Production is AWS RDS
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=metkurd_local
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_STORE=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Landing/admin-managed media (tool images + landing meta assets) should use shared storage in production.
# Set to s3 for Hetzner Object Storage on multi-node deployments.
LANDING_MEDIA_DISK=s3
LANDING_MEDIA_URL_STRATEGY=proxy
LANDING_MEDIA_PROXY_MAX_AGE=3600
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID_XTTS=
RUNPOD_ENDPOINT_ID_FTTS=
RUNPOD_ENDPOINT_ID_WASR=
RUNPOD_ENDPOINT_ID_QASR=
RUNPOD_ENDPOINT_ID_TRAN=
RUNPOD_ENDPOINT_ID_STEM=
RUNPOD_ENDPOINT_ID_KOCR=
RUNPOD_BASE_URL=https://api.runpod.ai
RUNPOD_TIMEOUT=60

VITE_APP_NAME="${APP_NAME}"

# Switch this per environment:
# Windows local:
YOUTUBE_PYTHON_TARGET=windows_local
YOUTUBE_PYTHON_BIN_WINDOWS_LOCAL=C:\Users\metone\AppData\Local\Programs\Python\Python310\python.exe

# Linux AWS EC2:
# YOUTUBE_PYTHON_TARGET=linux_aws_ec2
YOUTUBE_COOKIES_BROWSER=

PAYMENTS_DEFAULT_PROVIDER=fake
PAYMENTS_FAKE_ENABLED=true

FIB_ENABLED=false
FIB_ENV=staging

# Prefer these explicit per-profile hosts.
# Official docs currently show https://fib.stage.fib.iq for staging.
# If your assigned staging tenant rejects protected calls with
# "Jwt issuer is not configured", override the staging host to
# https://fib-stage.fib.iq for the affected profile(s).
FIB_PAYMENT_BASE_URL=
FIB_PAYMENT_BASE_URL_STAGING=https://fib.stage.fib.iq
FIB_PAYMENT_BASE_URL_PRODUCTION=https://fib.prod.fib.iq
FIB_SUBSCRIPTION_BASE_URL=
FIB_SUBSCRIPTION_BASE_URL_STAGING=https://fib.stage.fib.iq
FIB_SUBSCRIPTION_BASE_URL_PRODUCTION=https://fib.prod.fib.iq

FIB_PAYMENT_CLIENT_ID=
FIB_PAYMENT_CLIENT_SECRET=
FIB_SUBSCRIPTION_CLIENT_ID=
FIB_SUBSCRIPTION_CLIENT_SECRET=

# Deprecated fallback keys. Keep empty unless you need temporary backwards compatibility.
FIB_BASE_URL=
FIB_BASE_URL_STAGING=
FIB_BASE_URL_PRODUCTION=
FIB_CLIENT_ID=
FIB_CLIENT_SECRET=
FIB_CLIENT_ID_STAGING=
FIB_CLIENT_SECRET_STAGING=
FIB_CLIENT_ID_PRODUCTION=
FIB_CLIENT_SECRET_PRODUCTION=
FIB_CALLBACK_BASE_URL=${APP_URL}
FIB_CALLBACK_SECRET=
FIB_CALLBACK_SECRET_HEADER=x-callback-secret
FIB_HTTP_TIMEOUT=15
FIB_HTTP_RETRIES=2
FIB_HTTP_RETRY_SLEEP_MS=200
FIB_DIAGNOSTICS_ENABLED=false
FIB_REALM=fib-online-shop
FIB_TOKEN_TTL_SECONDS=60
FIB_PAYMENT_CATEGORY=ECOMMERCE
FIB_PAYMENT_EXPIRES_IN=PT1H
FIB_PAYMENT_REFUNDABLE_FOR=PT48H
FIB_SUBSCRIPTION_EXPIRES_IN=PT1H
FIB_SUBSCRIPTION_TRIAL_PERIOD=
FIB_SUBSCRIPTION_HOURLY_TESTING_ENABLED=false
FIB_SUBSCRIPTION_INTERVAL_MONTHLY=P1M
FIB_SUBSCRIPTION_INTERVAL_YEARLY=P1Y
FIB_SUBSCRIPTION_INTERVAL_HOURLY=PT1H
FIB_STATUS_SYNC_DELAY_SECONDS=15
FIB_STATUS_SYNC_MAX_ATTEMPTS=5
FIB_RECONCILIATION_ENABLED=true
FIB_RECONCILIATION_CHUNK_SIZE=100
FIB_RECONCILIATION_STALE_MINUTES=5
FIB_TOKEN_PATH=/auth/realms/{realm}/protocol/openid-connect/token
FIB_PAYMENTS_PATH=/protected/v1/payments
FIB_PAYMENT_STATUS_PATH=/protected/v1/payments/{paymentId}/status
FIB_PAYMENT_CANCEL_PATH=/protected/v1/payments/{paymentId}/cancel
FIB_SUBSCRIPTIONS_PATH=/protected/v1/subscriptions
FIB_SUBSCRIPTION_STATUS_PATH=/protected/v1/subscriptions/{subscriptionId}
FIB_SUBSCRIPTION_CANCEL_PATH=/protected/v1/subscriptions/{subscriptionId}/cancel

AREEBA_ENABLED=false
AREEBA_MODE=test
AREEBA_BASE_URL_TEST=https://gateway.areebapayment.com/api/v3
AREEBA_BASE_URL_LIVE=https://gateway.areebapayment.com/api/v3
AREEBA_USERNAME_TEST=
AREEBA_PASSWORD_TEST=
AREEBA_API_KEY_TEST=
AREEBA_USERNAME_LIVE=
AREEBA_PASSWORD_LIVE=
AREEBA_API_KEY_LIVE=
AREEBA_WEBHOOK_SECRET=
AREEBA_WEBHOOK_SECRET_HEADER=x-webhook-secret
AREEBA_WITH_REGISTER_ENABLED=false
AREEBA_SCHEDULE_ENABLED=false
