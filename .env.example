APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Use "**" to trust the direct proxy in front of this app (Cloudflare/load balancer/reverse proxy).
TRUSTED_PROXIES=**

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

MOBILE_API_TOKEN_EXPIRATION_DAYS=90
MOBILE_API_DOWNLOAD_URL_TTL_MINUTES=30
MOBILE_API_ONBOARDING_TOKEN_EXPIRATION_MINUTES=120
MOBILE_PHONE_OTP_TTL_SECONDS=300
MOBILE_PHONE_OTP_MAX_ATTEMPTS=5
MOBILE_PHONE_OTP_LOCK_SECONDS=600
MOBILE_PHONE_OTP_COOLDOWN_SECONDS=60

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# In Production is AWS RDS
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=metkurd_local
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_STORE=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Livewire temporary upload storage:
# - local for single-node/dev
# - s3 for production behind load balancer / multiple app VMs
# Production example:
# LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=s3
# Optional alias key (kept for backward compatibility)
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=s3
# Keep alias aligned with LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK for compatibility.
LIVEWIRE_TEMP_DISK=s3
LIVEWIRE_TEMP_UPLOAD_MAX_KB=102400
LIVEWIRE_TEMP_UPLOAD_MAX_MINUTES=15
STEM_MAX_UPLOAD_KB=102400
# Optional override (defaults to livewire-tmp)
# LIVEWIRE_TEMP_DIRECTORY=
# App-level STEM max upload size (in KB). 102400 = 100MB.
# Landing/admin-managed media (tool images + landing meta assets) should use shared storage in production.
# Set to s3 for Hetzner Object Storage on multi-node deployments.
LANDING_MEDIA_DISK=s3
LANDING_MEDIA_URL_STRATEGY=proxy
LANDING_MEDIA_PROXY_MAX_AGE=3600
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID_XTTS=
RUNPOD_ENDPOINT_ID_FTTS=
RUNPOD_ENDPOINT_ID_WASR=
RUNPOD_ENDPOINT_ID_QASR=
RUNPOD_ENDPOINT_ID_TRAN=
RUNPOD_ENDPOINT_ID_STEM=
RUNPOD_ENDPOINT_ID_KOCR=
RUNPOD_BASE_URL=https://api.runpod.ai
RUNPOD_TIMEOUT=60

TELEGRAM_BOT_TOKEN=
# Legacy single-group fallback (optional)
TELEGRAM_GROUP=
# Legacy contact key (kept for backwards compatibility)
TELEGRAM_GROUP_CON=
# Registration notifications
TELEGRAM_GROUP_REG=
# Checkout-created notifications (e.g. "FIB recurring checkout created")
TELEGRAM_GROUP_CHK=
# Successful paid/subscribed notifications (e.g. "NEW PAYMENT MESSAGE")
TELEGRAM_GROUP_PAY=

VITE_APP_NAME="${APP_NAME}"

# Switch this per environment:
# Windows local:
YOUTUBE_PYTHON_TARGET=windows_local
YOUTUBE_PYTHON_BIN_WINDOWS_LOCAL=C:\Users\metone\AppData\Local\Programs\Python\Python310\python.exe

# Linux AWS EC2:
# YOUTUBE_PYTHON_TARGET=linux_aws_ec2
YOUTUBE_COOKIES_BROWSER=

# Payments provider defaults:
# Development quickstart (fake provider only):
# PAYMENTS_DEFAULT_PROVIDER=fake
# PAYMENTS_FAKE_ENABLED=true
# FIB_ENABLED=false
#
# Production-safe default:
PAYMENTS_DEFAULT_PROVIDER=fib
PAYMENTS_FAKE_ENABLED=false
FIB_ENABLED=true
FIB_ENV=staging

# Prefer these explicit per-profile hosts.
# Official docs currently show https://fib.stage.fib.iq for staging.
# If your assigned staging tenant rejects protected calls with
# "Jwt issuer is not configured", override the staging host to
# https://fib-stage.fib.iq for the affected profile(s).

# Deprecated fallback keys. Keep empty unless you need temporary backwards compatibility.
FIB_PAYMENT_BASE_URL=
FIB_PAYMENT_BASE_URL_STAGING=
FIB_PAYMENT_BASE_URL_PRODUCTION=
FIB_SUBSCRIPTION_BASE_URL=
FIB_SUBSCRIPTION_BASE_URL_STAGING=
FIB_SUBSCRIPTION_BASE_URL_PRODUCTION=
FIB_PAYMENT_CLIENT_ID=
FIB_PAYMENT_CLIENT_SECRET=
FIB_SUBSCRIPTION_CLIENT_ID=
FIB_SUBSCRIPTION_CLIENT_SECRET=
FIB_REALM=
FIB_CALLBACK_BASE_URL=
FIB_CALLBACK_SECRET=
FIB_CALLBACK_SECRET_HEADER=
FIB_HTTP_TIMEOUT=
FIB_HTTP_RETRIES=
FIB_HTTP_RETRY_SLEEP_MS=
FIB_TOKEN_TTL_SECONDS=
FIB_DIAGNOSTICS_ENABLED=
FIB_PAYMENT_CATEGORY=
FIB_PAYMENT_EXPIRES_IN=
FIB_PAYMENT_REFUNDABLE_FOR=
FIB_SUBSCRIPTION_EXPIRES_IN=
FIB_SUBSCRIPTION_TRIAL_PERIOD=
FIB_SUBSCRIPTION_INTERVAL_MONTHLY=
FIB_SUBSCRIPTION_INTERVAL_YEARLY=
FIB_SUBSCRIPTION_HOURLY_TESTING_ENABLED=
FIB_SUBSCRIPTION_INTERVAL_HOURLY=
FIB_STATUS_SYNC_DELAY_SECONDS=
FIB_STATUS_SYNC_MAX_ATTEMPTS=
FIB_RECONCILIATION_ENABLED=
FIB_RECONCILIATION_CHUNK_SIZE=
FIB_RECONCILIATION_STALE_MINUTES=
FIB_TOKEN_PATH=
FIB_PAYMENTS_PATH=
FIB_PAYMENT_STATUS_PATH=
FIB_PAYMENT_CANCEL_PATH=
FIB_SUBSCRIPTIONS_PATH=
FIB_SUBSCRIPTION_STATUS_PATH=
FIB_SUBSCRIPTION_CANCEL_PATH=

AREEBA_ENABLED=false
AREEBA_MODE=test
AREEBA_BASE_URL_TEST=https://gateway.areebapayment.com/api/v3
AREEBA_BASE_URL_LIVE=https://gateway.areebapayment.com/api/v3
AREEBA_USERNAME_TEST=
AREEBA_PASSWORD_TEST=
AREEBA_API_KEY_TEST=
AREEBA_USERNAME_LIVE=
AREEBA_PASSWORD_LIVE=
AREEBA_API_KEY_LIVE=
AREEBA_WEBHOOK_SECRET=
AREEBA_WEBHOOK_SECRET_HEADER=x-webhook-secret
AREEBA_WITH_REGISTER_ENABLED=false
AREEBA_SCHEDULE_ENABLED=false
