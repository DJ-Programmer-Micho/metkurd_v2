APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID_XTTS=
RUNPOD_ENDPOINT_ID_FTTS=
RUNPOD_ENDPOINT_ID_WASR=
RUNPOD_ENDPOINT_ID_QASR=
RUNPOD_ENDPOINT_ID_STEM=
RUNPOD_ENDPOINT_ID_KOCR=
RUNPOD_BASE_URL=https://api.runpod.ai
RUNPOD_TIMEOUT=60

VITE_APP_NAME="${APP_NAME}"

# Switch this per environment:
# Windows local:
YOUTUBE_PYTHON_TARGET=windows_local
YOUTUBE_PYTHON_BIN_WINDOWS_LOCAL=C:\Users\metone\AppData\Local\Programs\Python\Python310\python.exe

# Linux AWS EC2:
# YOUTUBE_PYTHON_TARGET=linux_aws_ec2
YOUTUBE_COOKIES_BROWSER=

PAYMENTS_DEFAULT_PROVIDER=fake
PAYMENTS_FAKE_ENABLED=true

FIB_ENABLED=false
FIB_ENV=staging
FIB_BASE_URL_STAGING=https://fib.stage.fib.iq
FIB_BASE_URL_PRODUCTION=https://fib.prod.fib.iq
FIB_CLIENT_ID_STAGING=
FIB_CLIENT_SECRET_STAGING=
FIB_CLIENT_ID_PRODUCTION=
FIB_CLIENT_SECRET_PRODUCTION=
FIB_CALLBACK_SECRET=
FIB_CALLBACK_SECRET_HEADER=x-callback-secret
FIB_HTTP_TIMEOUT=15
FIB_HTTP_RETRIES=2
FIB_HTTP_RETRY_SLEEP_MS=200
FIB_REALM=fib-online-shop
FIB_TOKEN_TTL_SECONDS=60
FIB_STATUS_SYNC_DELAY_SECONDS=15
FIB_STATUS_SYNC_MAX_ATTEMPTS=5
FIB_TOKEN_PATH=/auth/realms/{realm}/protocol/openid-connect/token
FIB_PAYMENTS_PATH=/protected/v1/payments
FIB_PAYMENT_STATUS_PATH=/protected/v1/payments/{paymentId}/status
FIB_PAYMENT_CANCEL_PATH=/protected/v1/payments/{paymentId}/cancel
FIB_PAYMENT_REFUND_PATH=/protected/v1/payments/{paymentId}/refund

AREEBA_ENABLED=false
AREEBA_MODE=test
AREEBA_BASE_URL_TEST=https://gateway.areebapayment.com/api/v3
AREEBA_BASE_URL_LIVE=https://gateway.areebapayment.com/api/v3
AREEBA_USERNAME_TEST=
AREEBA_PASSWORD_TEST=
AREEBA_API_KEY_TEST=
AREEBA_USERNAME_LIVE=
AREEBA_PASSWORD_LIVE=
AREEBA_API_KEY_LIVE=
AREEBA_WEBHOOK_SECRET=
AREEBA_WEBHOOK_SECRET_HEADER=x-webhook-secret
AREEBA_WITH_REGISTER_ENABLED=false
AREEBA_SCHEDULE_ENABLED=false
